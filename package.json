    "test": "node scripts/cargo-runner.js test --manifest-path backend/Cargo.toml --offline",
    "test:backend": "node scripts/cargo-runner.js test --manifest-path backend/Cargo.toml --offline",
    "test:all": "node scripts/cargo-runner.js test --workspace --offline && npm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
