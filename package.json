{
  "name": "web-based-ml-model-evaluator",
  "version": "2.0.0",
  "private": true,
  "description": "Web-based ML model evaluator that runs entirely on the visitor's device (Rust compiled to WebAssembly)",
  "scripts": {
    "start": "node scripts/cargo-runner.js run -p web_ml_backend",
    "start:backend": "node scripts/cargo-runner.js run -p web_ml_backend",
    "build:backend": "node scripts/cargo-runner.js build -p web_ml_backend",
    "build:engine": "node scripts/engine.mjs build",
    "dev": "vite",
    "build": "npm run build:engine && vite build",
    "preview": "vite preview",
    "test": "node scripts/engine.mjs test",
    "test:all": "node scripts/engine.mjs test && npm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.0.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "lucide-react": "^0.300.0",
    "onnxruntime-web": "1.31.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
